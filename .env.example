# PostgreSQL Connection String (uses sslmode=verify-full for strict libpq v9 security)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/event_management?sslmode=verify-full&channel_binding=require"

# JWT Authentication Secret
JWT_SECRET="your_jwt_secret_key_here"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------
# REAL PAYMENT GATEWAY CONFIGURATIONS
# ----------------------------------------------------

# 1. Stripe Checkout & Payment Intents
STRIPE_SECRET_KEY="sk_test_your_stripe_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# 2. Razorpay Checkout (UPI, Cards, Netbanking)
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# 3. Cashfree Payments PG
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"

# 4. PhonePe Payment Gateway (UPI & Pay Page)
PHONEPE_MERCHANT_ID="PGTESTPAYUAT"
PHONEPE_SALT_KEY="099eb0cd-02cf-4e2a-8aca-3e6c6aff0399"
PHONEPE_SALT_INDEX="1"

# 5. PayPal International Checkout
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"

